---
import { Icon } from 'astro-icon/components';

interface Props {
  project: {
    title: string;
    company: string;
    category: string;
    icon: string;
    highlight: string;
    highlightLabel: string;
    context: string;
    role: string;
    result: string;
    tech: string[];
  };
}

const { project } = Astro.props;

const sections = [
  { label: 'Context', text: project.context },
  { label: 'My role', text: project.role },
  { label: 'Result', text: project.result },
];
---

<article class="project-card group relative bg-accent/5 border border-accent/10 rounded-2xl overflow-hidden hover:border-accent/40 transition-all duration-500 flex flex-col">

  <!-- Highlight band -->
  <div class="relative px-6 pt-6 pb-5 bg-accent/5 border-b border-accent/10 shrink-0">
    <div class="absolute top-4 right-4 p-2 bg-background/80 rounded-lg border border-accent/10 text-accent/80 group-hover:text-accent transition-colors duration-300">
      <Icon name={project.icon} class="w-5 h-5" />
    </div>
    <p class="font-heading font-bold text-accent text-3xl tracking-tight pr-12">{project.highlight}</p>
    <p class="font-mono text-[11px] uppercase tracking-widest text-subtext mt-1">{project.highlightLabel}</p>
  </div>

  <!-- Card body -->
  <div class="p-6 flex flex-col gap-4 flex-1">
    <div>
      <span class="inline-block text-[10px] uppercase tracking-widest font-bold px-2 py-0.5 rounded-full border text-accent bg-accent/10 border-accent/20">
        {project.category}
      </span>
      <h3 class="text-xl font-heading font-bold text-maintext mt-2">{project.title}</h3>
      <p class="text-accent/80 text-sm font-semibold">{project.company}</p>
    </div>

    <dl class="flex flex-col gap-3 flex-1">
      {sections.map((section) => (
        <div>
          <dt class="font-mono text-[10px] uppercase tracking-widest text-accent/70">{section.label}</dt>
          <dd class="text-subtext text-sm font-body leading-relaxed mt-0.5">{section.text}</dd>
        </div>
      ))}
    </dl>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2">
      {project.tech.map((t: string) => (
        <span class="rounded-md text-[10px] px-2 md:px-3 py-1 bg-accent/5 border border-accent/10 text-accent/80 group-hover:border-accent/40 group-hover:text-accent transition-colors duration-300">
          {t}
        </span>
      ))}
    </div>
  </div>
</article>

<style is:global>
  .project-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(40px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.8s;
    will-change: transform, opacity;
  }

  .project-card.reveal {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }
</style>
