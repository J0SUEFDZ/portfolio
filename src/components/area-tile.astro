---
import { Icon } from 'astro-icon/components';

interface Props {
  area: {
    icon: string;
    title: string;
    text: string;
    href?: string;
    linkLabel?: string;
  };
}

const { area } = Astro.props;
const Tag = area.href ? 'a' : 'div';
---

<Tag
  href={area.href}
  class={`scroll-reveal group flex gap-4 p-4 md:p-5 rounded-xl bg-accent/5 border border-accent/10 hover:border-accent/40 ${area.href ? 'hover:bg-accent/10' : ''}`}
>
  <div class="shrink-0 w-10 h-10 flex items-center justify-center rounded-lg bg-accent/15 text-accent">
    <Icon name={area.icon} class="w-5 h-5" />
  </div>
  <div>
    <h4 class="font-heading font-bold text-maintext text-base leading-snug">{area.title}</h4>
    <p class="text-subtext font-body text-sm leading-relaxed mt-1">{area.text}</p>
    {area.href && (
      <span class="inline-flex items-center gap-1 mt-2 font-mono text-[10px] uppercase tracking-widest text-accent/80 group-hover:text-accent">
        {area.linkLabel ?? 'See more'}
        <Icon name="mdi:arrow-right" class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" />
      </span>
    )}
  </div>
</Tag>
