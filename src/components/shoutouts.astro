---
import { Icon } from 'astro-icon/components';
import shoutouts from '../data/shoutouts.json';

const { quotes, sourceUrl } = shoutouts;
---

<section id="shoutouts" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="scroll-reveal mb-10">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
        <span class="text-accent">/</span> Shoutouts
      </h2>
      <p class="text-subtext font-body text-sm max-w-md">
        What the people I worked with say, in their own words.
      </p>
    </div>

    <div
      class="scroll-reveal shoutout-carousel relative rounded-2xl border border-accent/10 bg-accent/5"
      role="region"
      aria-roledescription="carousel"
      aria-label="Shoutouts from peers"
    >
      <Icon name="mdi:format-quote-open" class="absolute top-4 left-4 md:top-6 md:left-8 w-10 h-10 md:w-14 md:h-14 text-accent/20" aria-hidden="true" />

      <ul class="shoutout-track flex overflow-x-auto snap-x snap-mandatory" tabindex="0">
        {quotes.map((item, index) => (
          <li
            class="shoutout-slide snap-center shrink-0 w-full flex flex-col items-center justify-center text-center px-6 sm:px-16 md:px-24 pt-16 pb-8 md:pt-20 md:pb-10"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${quotes.length}`}
          >
            <figure class="max-w-3xl">
              <blockquote class="text-maintext font-body text-lg md:text-2xl leading-relaxed">
                {item.quote}
              </blockquote>
              <figcaption class="mt-6">
                <span class="block font-heading font-bold text-accent text-base md:text-lg">{item.name}</span>
                {item.role && (
                  <span class="block font-mono text-[11px] uppercase tracking-widest text-subtext mt-1">{item.role}</span>
                )}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      {quotes.length > 1 && (
        <div class="flex items-center justify-center gap-4 pb-6">
          <button type="button" class="shoutout-nav" data-direction="-1" aria-label="Previous shoutout">
            <Icon name="mdi:chevron-left" class="w-5 h-5" />
          </button>
          <div class="flex items-center gap-2">
            {quotes.map((item, index) => (
              <button
                type="button"
                class:list={['shoutout-dot', { active: index === 0 }]}
                data-index={index}
                aria-label={`Show shoutout from ${item.name}`}
              ></button>
            ))}
          </div>
          <button type="button" class="shoutout-nav" data-direction="1" aria-label="Next shoutout">
            <Icon name="mdi:chevron-right" class="w-5 h-5" />
          </button>
        </div>
      )}
    </div>

    {sourceUrl && (
      <p class="scroll-reveal text-center text-subtext text-xs font-body mt-6">
        Excerpts from recommendations on{' '}
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="text-accent/80 hover:text-accent underline underline-offset-4 decoration-accent/40">LinkedIn</a>.
      </p>
    )}
  </div>
</section>

<style>
  .shoutout-track {
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  .shoutout-track::-webkit-scrollbar {
    display: none;
  }

  .shoutout-track:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    border-radius: 1rem;
  }

  .shoutout-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: color-mix(in srgb, var(--color-accent) 75%, transparent);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .shoutout-nav:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .shoutout-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-accent) 25%, transparent);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .shoutout-dot.active {
    width: 1.5rem;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .shoutout-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import { initScrollReveal } from '../utils/reveal';

  function initShoutouts() {
    initScrollReveal('#shoutouts', 1);

    const carousel = document.querySelector('.shoutout-carousel');
    const track = carousel?.querySelector<HTMLElement>('.shoutout-track');
    if (!carousel || !track) return;

    const slides = Array.from(track.querySelectorAll<HTMLElement>('.shoutout-slide'));
    const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.shoutout-dot'));
    let current = 0;

    const goTo = (index: number) => {
      // Wraps around so next on the last slide returns to the first
      const target = (index + slides.length) % slides.length;
      track.scrollTo({ left: slides[target].offsetLeft - track.offsetLeft });
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          current = slides.indexOf(entry.target as HTMLElement);
          dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
        }
      });
    }, { root: track, threshold: 0.6 });

    slides.forEach((slide) => observer.observe(slide));

    carousel.querySelectorAll<HTMLElement>('.shoutout-nav').forEach((button) => {
      button.addEventListener('click', () => goTo(current + Number(button.dataset.direction)));
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => goTo(Number(dot.dataset.index)));
    });

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); goTo(current + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(current - 1); }
    });
  }

  initShoutouts();
  document.addEventListener('astro:after-swap', initShoutouts);
</script>
