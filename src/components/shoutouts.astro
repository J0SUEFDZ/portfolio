---
import { Icon } from 'astro-icon/components';
import shoutouts from '../data/shoutouts.json';

const { quotes, sourceUrl } = shoutouts;
---

<section id="shoutouts" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="scroll-reveal mb-10">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
        <span class="text-accent">/</span> Shoutouts
      </h2>
      <p class="text-subtext font-body text-sm max-w-md">
        What the people I worked with say, in their own words.
      </p>
    </div>

    <div
      class="scroll-reveal shoutout-carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label="Shoutouts from peers"
    >
      <ul class="shoutout-track flex gap-6 overflow-x-auto snap-x snap-mandatory py-1" tabindex="0">
        {quotes.map((item, index) => (
          <li
            class="shoutout-card snap-start shrink-0 flex"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${quotes.length}`}
          >
            <figure class="group relative flex flex-col justify-center w-full rounded-2xl border border-accent/10 bg-accent/5 hover:border-accent/40 transition-colors duration-500 p-6 md:p-8">
              <Icon name="mdi:format-quote-open" class="w-8 h-8 text-accent/30 group-hover:text-accent/60 transition-colors duration-300 mb-4 shrink-0" aria-hidden="true" />
              <blockquote class="text-maintext font-body text-base leading-relaxed">
                {item.quote}
              </blockquote>
              <figcaption class="mt-6 pt-4 border-t border-accent/10">
                <span class="block font-heading font-bold text-accent text-base">{item.name}</span>
                {item.role && (
                  <span class="block font-mono text-[11px] uppercase tracking-widest text-subtext mt-1">{item.role}</span>
                )}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      {quotes.length > 1 && (
        <div class="shoutout-controls flex items-center justify-center gap-4 mt-8">
          <button type="button" class="shoutout-nav" data-direction="-1" aria-label="Previous shoutouts">
            <Icon name="mdi:chevron-left" class="w-5 h-5" />
          </button>
          <div class="shoutout-dots flex items-center gap-2"></div>
          <button type="button" class="shoutout-nav" data-direction="1" aria-label="Next shoutouts">
            <Icon name="mdi:chevron-right" class="w-5 h-5" />
          </button>
        </div>
      )}
    </div>

    {sourceUrl && (
      <p class="scroll-reveal text-center text-subtext text-xs font-body mt-6">
        Excerpts from recommendations on{' '}
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="text-accent/80 hover:text-accent underline underline-offset-4 decoration-accent/40">LinkedIn</a>.
      </p>
    )}
  </div>
</section>

<style>
  .shoutout-track {
    --per-view: 1;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  .shoutout-track::-webkit-scrollbar {
    display: none;
  }

  .shoutout-track:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 1rem;
  }

  /* Card width fills the track evenly with --per-view cards, minus the gaps between them */
  .shoutout-card {
    width: calc((100% - (var(--per-view) - 1) * 1.5rem) / var(--per-view));
  }

  @media (min-width: 768px) {
    .shoutout-track {
      --per-view: 2;
    }
  }

  @media (min-width: 1024px) {
    .shoutout-track {
      --per-view: 3;
    }
  }

  .shoutout-controls.hidden {
    display: none;
  }

  .shoutout-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: color-mix(in srgb, var(--color-accent) 75%, transparent);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .shoutout-nav:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .shoutout-dots :global(.shoutout-dot) {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-accent) 25%, transparent);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .shoutout-dots :global(.shoutout-dot.active) {
    width: 1.5rem;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .shoutout-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import { initScrollReveal } from '../utils/reveal';

  function initShoutouts() {
    initScrollReveal('#shoutouts', 1);

    const carousel = document.querySelector('.shoutout-carousel');
    const track = carousel?.querySelector<HTMLElement>('.shoutout-track');
    const dotsContainer = carousel?.querySelector<HTMLElement>('.shoutout-dots');
    const controls = carousel?.querySelector<HTMLElement>('.shoutout-controls');
    if (!carousel || !track || !dotsContainer || !controls) return;

    const cards = Array.from(track.querySelectorAll<HTMLElement>('.shoutout-card'));
    let perView = 1;
    let pageCount = 1;
    let current = 0;

    const pageStart = (page: number) => Math.min(page * perView, cards.length - perView);

    const goTo = (page: number) => {
      // Wraps around so next on the last page returns to the first
      const target = (page + pageCount) % pageCount;
      const card = cards[pageStart(target)];
      track.scrollTo({ left: card.offsetLeft - track.offsetLeft });
    };

    const updateActive = () => {
      const firstVisible = cards.findIndex((card) => card.offsetLeft - track.offsetLeft >= track.scrollLeft - 4);
      // The last page may overlap the previous one, so snap to it once scrolled to the end
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      current = atEnd ? pageCount - 1 : Math.floor(Math.max(firstVisible, 0) / perView);
      dotsContainer.querySelectorAll('.shoutout-dot').forEach((dot, i) => dot.classList.toggle('active', i === current));
    };

    // Dots depend on how many cards fit per view, which changes with the breakpoint
    const layout = () => {
      perView = Number(getComputedStyle(track).getPropertyValue('--per-view')) || 1;
      pageCount = Math.ceil(cards.length / perView);
      controls.classList.toggle('hidden', pageCount <= 1);

      dotsContainer.replaceChildren(...Array.from({ length: pageCount }, (_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'shoutout-dot';
        dot.setAttribute('aria-label', `Show shoutouts page ${i + 1} of ${pageCount}`);
        dot.addEventListener('click', () => goTo(i));
        return dot;
      }));
      updateActive();
    };

    let scrollFrame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(scrollFrame);
      scrollFrame = requestAnimationFrame(updateActive);
    }, { passive: true });

    carousel.querySelectorAll<HTMLElement>('.shoutout-nav').forEach((button) => {
      button.addEventListener('click', () => goTo(current + Number(button.dataset.direction)));
    });

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); goTo(current + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(current - 1); }
    });

    new ResizeObserver(layout).observe(track);
  }

  initShoutouts();
  document.addEventListener('astro:after-swap', initShoutouts);
</script>
